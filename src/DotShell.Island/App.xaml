<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DotShell.Island.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
              Палитра DotShell.
              Всё, что зависит от акцента, берётся ОТСЮДА, а значение
              {ThemeResource AccentBrush} подменяется в рантайме из ThemeBus.
              Поэтому смена цвета = одна операция, а не обход всего дерева.
            -->
            <SolidColorBrush x:Key="DsAccent" Color="#D71920" />
            <SolidColorBrush x:Key="DsAccentSoft" Color="#33D71920" />
            <SolidColorBrush x:Key="DsBackground" Color="#000000" />
            <SolidColorBrush x:Key="DsSurface" Color="#121214" />
            <SolidColorBrush x:Key="DsSurfaceAlt" Color="#17171A" />
            <SolidColorBrush x:Key="DsBorder" Color="#26262B" />
            <SolidColorBrush x:Key="DsText" Color="#ECECEE" />
            <SolidColorBrush x:Key="DsTextMuted" Color="#8A8A93" />
            <SolidColorBrush x:Key="DsGhostDot" Color="#14FFFFFF" />

            <!-- Точечный шрифт. Положи свой .ttf/.otf в Assets/ и он подхватится.
                 Если файла нет — WinUI молча использует следующий по списку. -->
            <FontFamily x:Key="DsDotFont">ms-appx:///Assets/#Ndot 55, Cascadia Mono, Consolas</FontFamily>
            <FontFamily x:Key="DsMonoFont">Cascadia Mono, Consolas, Segoe UI</FontFamily>

            <!-- Стиль "чипа" — маленькая подпис-таблетка в духе Nothing -->
            <Style x:Key="DsChip" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource DsSurfaceAlt}" />
                <Setter Property="BorderBrush" Value="{StaticResource DsBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="999" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="DsChipText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DsMonoFont}" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource DsTextMuted}" />
                <Setter Property="CharacterSpacing" Value="60" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Плоская кнопка-таблетка -->
            <Style x:Key="DsTabButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource DsBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource DsTextMuted}" />
                <Setter Property="FontFamily" Value="{StaticResource DsMonoFont}" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="80" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>

            <!-- Круглая кнопка управления плеером -->
            <Style x:Key="DsRoundButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{StaticResource DsSurfaceAlt}" />
                <Setter Property="BorderBrush" Value="{StaticResource DsBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource DsText}" />
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="999" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
