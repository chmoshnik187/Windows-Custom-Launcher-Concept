<UserControl x:Class="DotShell.Island.Wpf.IslandNotification"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DotShell.Island.Wpf.Controls">
    <!--
      Уведомление внутри капсулы: юнит, «пасть» и текст.

      Пасть — два треугольника, которые при появлении разъезжаются: верхний вверх,
      нижний вниз, выходя за края капсулы. Слой лежит НАД пилюлей (добавляется в
      корневую сетку из кода), поэтому её ClipToBounds их не режет.
    -->
    <Grid x:Name="Layout" HorizontalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Юнит с пастью: Canvas шире самого юнита, чтобы зубки было куда разводить -->
        <Canvas x:Name="MouthCanvas" Grid.Column="0" Width="46" Height="52"
                VerticalAlignment="Center" ClipToBounds="False">
            <Path x:Name="MouthTop" Fill="{DynamicResource DsAccent}" Opacity="0"
                  Data="M 0,24 L 22,24 L 11,11 Z" Canvas.Left="0" Canvas.Top="0">
                <Path.RenderTransform>
                    <TranslateTransform x:Name="TopShift" Y="0" />
                </Path.RenderTransform>
            </Path>
            <Path x:Name="MouthBottom" Fill="{DynamicResource DsAccent}" Opacity="0"
                  Data="M 0,24 L 22,24 L 11,37 Z" Canvas.Left="0" Canvas.Top="0">
                <Path.RenderTransform>
                    <TranslateTransform x:Name="BottomShift" Y="0" />
                </Path.RenderTransform>
            </Path>

            <controls:Units x:Name="Faces" Canvas.Left="16" Canvas.Top="8" />
        </Canvas>

        <StackPanel x:Name="Texts" Grid.Column="1" VerticalAlignment="Center"
                    Margin="10,0,16,0" MinWidth="40">
            <controls:TrackedText x:Name="TitleText" FontSize="8" Tracking="0.30"
                                  Brush="{DynamicResource DsAccent}" HorizontalAlignment="Center" />
            <TextBlock x:Name="MessageText" FontFamily="Segoe UI" FontSize="11.5"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource DsText}" Margin="0,1,0,0"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
