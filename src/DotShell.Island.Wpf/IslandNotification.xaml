<UserControl x:Class="DotShell.Island.Wpf.IslandNotification"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DotShell.Island.Wpf.Controls">
    <!--
      Уведомление внутри капсулы: юнит слева, текст справа.

      Никаких «зубов»: владелец справедливо заметил, что отдельные треугольники рядом
      с юнитом выглядят чужеродно. Вместо них юнит сам реагирует — водит взглядом по
      строке, как человек, читающий уведомление (см. Units.Reading).
    -->
    <Grid x:Name="Layout" HorizontalAlignment="Left">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <controls:Units x:Name="Faces" Grid.Column="0" VerticalAlignment="Center" Margin="6,0,0,0" />

        <StackPanel x:Name="Texts" Grid.Column="1" VerticalAlignment="Center"
                    Margin="12,0,16,0" MinWidth="40" HorizontalAlignment="Left">
            <controls:TrackedText x:Name="TitleText" FontSize="8" Tracking="0.30"
                                  Brush="{DynamicResource DsAccent}" HorizontalAlignment="Left" />
            <TextBlock x:Name="MessageText" FontFamily="Segoe UI" FontSize="11.5"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource DsText}" Margin="0,1,0,0"
                       HorizontalAlignment="Left" />
        </StackPanel>
    </Grid>
</UserControl>
