<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Стили виджетов рабочего стола: та же семья, что и стили острова,
         но живут своим словарём — виджеты создаются кодом, без XAML-окна. -->

    <Style x:Key="WRound" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource DsTextMuted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="999">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DsAccent}" />
                            <Setter Property="Foreground" Value="{DynamicResource DsAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WRoundAccent" TargetType="Button" BasedOn="{StaticResource WRound}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="{DynamicResource DsAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource DsOnAccent}" />
    </Style>

    <Style x:Key="WTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource DsText}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="WSub" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextMuted}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="WButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource DsTextMuted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DsAccent}" />
                            <Setter Property="Foreground" Value="{DynamicResource DsText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource DsText}" />
        <Setter Property="CaretBrush" Value="{DynamicResource DsAccent}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource DsAccent}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="8,6" />
    </Style>

    <!-- Тонкий слайдер в стиле острова: дорожка-линия и один акцентный бегунок.
         Системный выглядит как деталь от чужой машины. -->
    <Style x:Key="WSlider" TargetType="Slider">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border Height="3" CornerRadius="2" VerticalAlignment="Center"
                                Background="{DynamicResource DsBorder}" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="3" CornerRadius="2" VerticalAlignment="Center"
                                                    Background="{DynamicResource DsAccent}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="12" Height="12">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Width="12" Height="12"
                                                     Fill="{DynamicResource DsAccent}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ручка изменения размера: три точки в углу, как «захват» у Nothing OS.
         Thumb, а не Border с мышью: Thumb сам забирает ввод в захват и корректно
         переживает быстрый драг за пределы окна. -->
    <Style x:Key="WResizeGrip" TargetType="Thumb">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="0,0,3,3" />
        <Setter Property="Cursor" Value="SizeNWSE" />
        <Setter Property="ToolTip" Value="Потянуть — изменить размер" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Ellipse Width="3" Height="3" Fill="{DynamicResource DsTextMuted}"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" />
                        <Ellipse Width="3" Height="3" Fill="{DynamicResource DsTextMuted}"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,7,1" />
                        <Ellipse Width="3" Height="3" Fill="{DynamicResource DsTextMuted}"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,7" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WChip" TargetType="Border">        <Setter Property="Background" Value="{DynamicResource DsSurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="Margin" Value="0,0,6,6" />
    </Style>

    <!-- Тонкий тёмный ползунок: системный светлый в тёмном виджете выглядел
         как чужая деталь из другой программы (замечание владельца). -->
    <Style x:Key="DsScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <!-- Без ViewportSize ползунок растягивался на всю дорожку
                                 и выглядел красной полосой во всё окно. -->
                            <Track.ViewportSize>
                                <Binding Path="ViewportSize" RelativeSource="{RelativeSource TemplatedParent}" />
                            </Track.ViewportSize>
                            <Track.Thumb>
                                <Thumb MinHeight="24">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource DsBorder}" CornerRadius="2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar" BasedOn="{StaticResource DsScrollBar}" />

</ResourceDictionary>
