<UserControl x:Class="DotShell.Island.Wpf.Controls.DotClock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DotShell.Island.Wpf.Controls"
             Focusable="False">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

        <!-- Часы. FixedColumns=10 — ровно две цифры по 5 ячеек, иначе "11" прыгает относительно "08" -->
        <controls:DotText x:Name="HoursDots"
                          FixedColumns="10"
                          CellSize="4" Gap="2" SourceFontSize="26"
                          VerticalAlignment="Center" />

        <!--
          Двоеточие не из шрифта, а двумя настоящими кружками: так оно гарантированно
          попадает в ту же сетку, что и цифры, и мигает ровно в ритм секундам.
        -->
        <Grid x:Name="Separator" Width="6" Margin="3,0" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Ellipse x:Name="SepTop" Grid.Row="0" Width="4" Height="4" Margin="0,0,0,5" />
            <Ellipse x:Name="SepBottom" Grid.Row="1" Width="4" Height="4" Margin="0,5,0,0" />
        </Grid>

        <!-- Минуты красятся акцентом: фирменная деталь — белое плюс одна цветная часть -->
        <controls:DotText x:Name="MinutesDots"
                          FixedColumns="10"
                          CellSize="4" Gap="2" SourceFontSize="26"
                          VerticalAlignment="Center" />
    </StackPanel>
</UserControl>
