<Window x:Class="DotShell.Island.Wpf.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DotShell.Island.Wpf.Controls"
        Title="DotShell Launcher"
        Width="660"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="LaunchItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="Закрепить плиткой на острове" Click="OnPinToIsland" />
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderThickness="1"
                                BorderBrush="Transparent" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource DsSurfaceAlt}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource DsAccentGhost}" />
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource DsAccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="18"
            Background="{DynamicResource DsBackground}"
            BorderBrush="{DynamicResource DsAccentSoft}"
            BorderThickness="1"
            Padding="18,14"
            Margin="12">
        <StackPanel>
            <!-- Запрос, набранный точками: фирменный штрих, как часы в острове -->
            <controls:DotText x:Name="QueryDots" HorizontalAlignment="Left"
                              Margin="2,0,0,8" SourceFontSize="20" />

            <TextBox x:Name="SearchBox"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource DsText}"
                     CaretBrush="{DynamicResource DsAccent}"
                     SelectionBrush="{DynamicResource DsAccent}"
                     FontFamily="Segoe UI" FontSize="18"
                     Padding="2,0" Margin="0,0,0,10"
                     TextChanged="OnSearchChanged"
                     PreviewKeyDown="OnSearchKeyDown" />

            <Border Height="1" Background="{DynamicResource DsBorder}" Margin="0,0,0,8" />

            <ListBox x:Name="Results"
                     Background="Transparent" BorderThickness="0"
                     MaxHeight="330"
                     ItemContainerStyle="{StaticResource LaunchItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnResultDoubleClicked">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Width="24" Height="24"
                                   Source="{Binding Icon}"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontFamily="Segoe UI" FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource DsText}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Target}" FontFamily="Segoe UI" FontSize="9"
                                           Foreground="{DynamicResource DsTextMuted}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="StatusLine" Margin="2,8,0,0"
                       FontFamily="Segoe UI" FontSize="9"
                       Foreground="{DynamicResource DsTextMuted}"
                       Text="Enter — запустить · ↑↓ — выбор · Alt+Enter — папка программы · Esc — закрыть" />
        </StackPanel>
    </Border>
</Window>
